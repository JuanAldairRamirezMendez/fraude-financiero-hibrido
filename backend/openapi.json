{
  "openapi": "3.1.0",
  "info": {
    "title": "SentinelAI Fraud API",
    "description": "Contrato congelado de la API de fraude. El frontend genera sus tipos TypeScript desde este archivo con `pnpm gen:api`.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness and readiness",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/metadata": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Form contract, categories and model information",
        "operationId": "metadata_api_v1_metadata_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyze": {
      "post": {
        "tags": [
          "Analyze"
        ],
        "summary": "Score a transaction and explain it with SHAP",
        "operationId": "analyze_api_v1_analyze_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "access_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Access Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid transaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Model unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/overview": {
      "get": {
        "tags": [
          "Overview"
        ],
        "summary": "Dashboard KPIs and server-side transaction pagination",
        "operationId": "overview_api_v1_overview_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Pagesize"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "decision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "Flagged",
                    "Review",
                    "Approved"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Decision"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Country"
            }
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ],
              "title": "Transactiontype"
            }
          },
          {
            "name": "minScore",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minscore"
            }
          },
          {
            "name": "maxScore",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maxscore"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "id",
                "customerId",
                "amount",
                "score",
                "transactionHour",
                "transactionDayOfWeek",
                "country"
              ],
              "type": "string",
              "default": "score",
              "title": "Sort"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "desc",
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "Model health, drift and persisted alerts",
        "operationId": "models_api_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate a user",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate the refresh session",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          },
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          },
          {
            "name": "csrf_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Csrf Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revoke the refresh session",
        "operationId": "logout_api_v1_auth_logout_post",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Csrf-Token"
            }
          },
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          },
          {
            "name": "csrf_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Csrf Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get the current user",
        "operationId": "me_api_v1_auth_me_get",
        "parameters": [
          {
            "name": "access_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Access Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Ask the fraud operations assistant",
        "operationId": "chat_api_v1_chat_post",
        "parameters": [
          {
            "name": "access_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Access Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Gemini unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "transactionHour": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Transactionhour"
          },
          "transactionDayOfWeek": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Transactiondayofweek"
          },
          "accountAgeDays": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Accountagedays"
          },
          "previousChargebacks": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Previouschargebacks"
          },
          "merchantCategory": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Merchantcategory"
          },
          "transactionCountry": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Transactioncountry"
          },
          "deviceType": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Devicetype"
          },
          "transactionType": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Transactiontype"
          },
          "geoLocationRegion": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Geolocationregion"
          },
          "isInternational": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Isinternational"
          },
          "isHighRiskMerchantCategory": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ishighriskmerchantcategory"
          },
          "isWeekend": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Isweekend"
          },
          "customerTotalTransactions30d": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Customertotaltransactions30D"
          },
          "customerRiskScore": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Customerriskscore"
          },
          "transactionAmount": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Transactionamount"
          },
          "avgTransactionAmount30dCustomer": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Avgtransactionamount30Dcustomer"
          },
          "transactionVelocity1h": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Transactionvelocity1H"
          },
          "transactionVelocity24h": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Transactionvelocity24H"
          },
          "decisionThreshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Decisionthreshold",
            "default": 0.5
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transactionHour",
          "transactionDayOfWeek",
          "accountAgeDays",
          "previousChargebacks",
          "merchantCategory",
          "transactionCountry",
          "deviceType",
          "transactionType",
          "geoLocationRegion",
          "isInternational",
          "isHighRiskMerchantCategory",
          "isWeekend",
          "customerTotalTransactions30d",
          "customerRiskScore",
          "transactionAmount",
          "avgTransactionAmount30dCustomer",
          "transactionVelocity1h",
          "transactionVelocity24h"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "decisionId": {
            "type": "string",
            "title": "Decisionid"
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Level"
          },
          "blocked": {
            "type": "boolean",
            "title": "Blocked"
          },
          "signalsTriggered": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Signalstriggered"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latencyms"
          },
          "shap": {
            "items": {
              "$ref": "#/components/schemas/ShapContribution"
            },
            "type": "array",
            "title": "Shap"
          },
          "topDriver": {
            "$ref": "#/components/schemas/TopDriver"
          },
          "modelVersion": {
            "type": "string",
            "title": "Modelversion"
          },
          "calibratedThreshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Calibratedthreshold"
          },
          "idempotentReplay": {
            "type": "boolean",
            "title": "Idempotentreplay",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decisionId",
          "probability",
          "score",
          "level",
          "blocked",
          "signalsTriggered",
          "latencyMs",
          "shap",
          "topDriver",
          "modelVersion",
          "calibratedThreshold"
        ],
        "title": "AnalyzeResponse"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "user",
          "expires_in"
        ],
        "title": "AuthResponse"
      },
      "AuthStatusResponse": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthUser"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "AuthStatusResponse"
      },
      "AuthUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "analyst",
              "viewer"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role"
        ],
        "title": "AuthUser"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 12,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
